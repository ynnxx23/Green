RewriteEngine On

# Si el archivo existe físicamente, servirlo directamente (no pasar al front controller)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Si el directorio existe, servirlo directamente
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Todo lo demás se envía al front controller index.php
RewriteRule ^ index.php [QSA,L]
