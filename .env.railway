# =============================================================================
# Variables de entorno para Railway (producción)
# Copiar estas variables al dashboard de Railway (Variables de Entorno)
# =============================================================================

# Entorno
APP_ENV=production

# URL pública de tu aplicación en Railway (ej: https://tu-app.railway.app)
APP_URL=https://tu-app.railway.app

# Base de datos MySQL de Railway (proporcionada por Railway automáticamente)
# DB_HOST se configura automáticamente al agregar el servicio MySQL
DB_HOST=${MYSQL_HOST}
DB_PORT=${MYSQL_PORT:-3306}
DB_NAME=${MYSQL_DATABASE:-railway}
DB_USER=${MYSQL_USER:-root}
DB_PASSWORD=${MYSQL_PASSWORD}

# Cookies de sesión seguras (HTTPS en producción)
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax

# Directorio de logs (Railway usa /data para almacenamiento persistente)
LOG_DIR=/data/logs

# Rate limiting
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_RATE=1

# Cloudinary (opcional, para subir imágenes de productos)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_FOLDER=productos
